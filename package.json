{
  "name": "sim",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "predev": "(node tools/assets/pull.mjs --check --quiet --set web,runtime || echo 'warning: media missing, run pnpm assets:pull') && node tools/assets/mars-web.mjs",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @sim/web build && node tools/assets/mars-web.mjs",
    "build:viewer": "node tools/assets/mars-web.mjs",
    "pretest": "node tools/assets/pull.mjs --check --quiet --set web,runtime",
    "test": "pnpm -r --filter '!mars-campus-viewer' test && pnpm test:mars",
    "test:replay": "pnpm --filter @sim/server test:replay",
    "start": "node --experimental-strip-types apps/server/src/main.ts",
    "typecheck": "pnpm -r exec tsc --noEmit -p .",
    "check": "pnpm typecheck && pnpm test",
    "test:mars": "pnpm --filter mars-campus-viewer test:engine",
    "test:mars:release": "pnpm --filter mars-campus-viewer gate",
    "test:client": "node --test --test-concurrency=1 tools/edge-skill/*.test.mjs tools/client-eval/*.test.mjs",
    "e2e:smoke": "node e2e/local-smoke.mjs",
    "assets:pull": "node tools/assets/pull.mjs",
    "assets:check": "node tools/assets/pull.mjs --check",
    "prepare": "node .github/scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
